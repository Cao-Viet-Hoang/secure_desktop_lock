<Window
    x:Class="SecureDesktopLock.UI.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:SecureDesktopLock.Utils"
    mc:Ignorable="d"

    Title="SecureDesktopLock"
    WindowStyle="None"
    WindowState="Maximized"
    Topmost="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="#FF0A0A0F"
    Cursor="Arrow"
    Loaded="LockWindow_Loaded"
    Closing="LockWindow_Closing"
    KeyDown="LockWindow_KeyDown">

    <Window.Resources>

        <!-- Converter instances -->
        <utils:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <utils:BoolNegationConverter     x:Key="BoolNegationConverter"/>

        <!-- ================================================================ -->
        <!-- Shared colours / brushes                                         -->
        <!-- ================================================================ -->
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#FF0A0A0F"/>
        <SolidColorBrush x:Key="PanelBrush"         Color="#1A1A2E"/>
        <SolidColorBrush x:Key="AccentBrush"         Color="#E94560"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888AA"/>
        <SolidColorBrush x:Key="InputBackBrush"     Color="#0F0F1A"/>
        <SolidColorBrush x:Key="InputBorderBrush"   Color="#3A3A5C"/>
        <SolidColorBrush x:Key="ButtonHoverBrush"   Color="#C73652"/>

        <!-- ================================================================ -->
        <!-- Button style                                                     -->
        <!-- ================================================================ -->
        <Style x:Key="UnlockButtonStyle" TargetType="Button">
            <Setter Property="Background"           Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"           Value="White"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="FontSize"             Value="14"/>
            <Setter Property="FontWeight"           Value="SemiBold"/>
            <Setter Property="Padding"              Value="0"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="FocusVisualStyle"     Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#A02040"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#55334455"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ -->
        <!-- PasswordBox style                                                -->
        <!-- ================================================================ -->
        <Style x:Key="LockPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background"       Value="{StaticResource InputBackBrush}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="18"/>
            <Setter Property="Padding"          Value="12,10"/>
            <Setter Property="PasswordChar"     Value="●"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <Grid Margin="12,0">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    VerticalAlignment="Center"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- Root dark overlay that fills every pixel                          -->
    <!-- ================================================================ -->
    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- ============================================================ -->
        <!-- DEV MODE banner — visible only in dev/debug builds           -->
        <!-- ============================================================ -->
        <Border
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Background="#CC2A1F00"
            BorderBrush="#FFB300"
            BorderThickness="0,0,0,2"
            Padding="0,10"
            Visibility="{Binding IsDevMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⚠" FontSize="16" Foreground="#FFB300"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock FontSize="13" Foreground="#FFB300" FontWeight="Bold"
                           VerticalAlignment="Center">
                    <Run Text="DEV MODE"/>
                    <Run Text="  —  " Foreground="#CC8800"/>
                    <Run Text="Password: "/>
                    <Run Text="123456" FontWeight="ExtraBold" Foreground="#FFD54F"/>
                    <Run Text="   (Firebase disabled)" Foreground="#CC8800" FontSize="11"/>
                </TextBlock>
                <TextBlock Text="⚠" FontSize="16" Foreground="#FFB300"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Subtle radial gradient in the centre for depth -->
        <Ellipse
            Width="700" Height="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A1A3E" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ============================================================ -->
        <!-- Central lock panel                                           -->
        <!-- ============================================================ -->
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="420"
            Background="{StaticResource PanelBrush}"
            CornerRadius="12"
            Padding="40,36">

            <Border.Effect>
                <DropShadowEffect
                    Color="#000000"
                    BlurRadius="40"
                    ShadowDepth="0"
                    Opacity="0.7"/>
            </Border.Effect>

            <StackPanel>

                <!-- Lock icon (Unicode padlock) -->
                <TextBlock
                    Text="🔒"
                    FontSize="42"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"/>

                <!-- Application title -->
                <TextBlock
                    Text="DESKTOP LOCKED"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,4"/>

                <!-- Machine ID sub-label -->
                <TextBlock
                    x:Name="MachineIdLabel"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28"
                    Text="{Binding MachineId, StringFormat='Machine: {0}'}"/>

                <!-- Password label -->
                <TextBlock
                    Text="Enter Password"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,6"/>

                <!-- Password input -->
                <PasswordBox
                    x:Name="PasswordInput"
                    Style="{StaticResource LockPasswordBoxStyle}"
                    Height="54"
                    Margin="0,0,0,16"
                    ToolTip="Enter the unlock password"/>

                <!-- Unlock button -->
                <Button
                    x:Name="UnlockButton"
                    Content="UNLOCK"
                    Style="{StaticResource UnlockButtonStyle}"
                    Height="46"
                    IsDefault="True"
                    Click="UnlockButton_Click"
                    IsEnabled="{Binding IsUnlocking, Converter={StaticResource BoolNegationConverter}, FallbackValue=True}"
                    Margin="0,0,0,16"/>

                <!-- Status / feedback message -->
                <TextBlock
                    x:Name="StatusText"
                    Text="{Binding StatusMessage}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource AccentBrush}"
                    MinHeight="18"/>

                <!-- Busy indicator -->
                <ProgressBar
                    x:Name="BusyBar"
                    IsIndeterminate="True"
                    Height="3"
                    Margin="0,12,0,0"
                    Background="Transparent"
                    Foreground="{StaticResource AccentBrush}"
                    BorderThickness="0"
                    Visibility="{Binding IsUnlocking, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Bottom info bar                                              -->
        <!-- ============================================================ -->
        <TextBlock
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,18"
            FontSize="11"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="SecureDesktopLock  ·  Protected by DPAPI + Firebase"/>

    </Grid>
</Window>
