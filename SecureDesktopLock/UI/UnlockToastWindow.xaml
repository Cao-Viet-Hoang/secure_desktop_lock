<Window
    x:Class="SecureDesktopLock.UI.UnlockToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UnlockToast"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    Loaded="Window_Loaded">

    <!--
        Small always-on-top toast that appears at the bottom-right corner
        after a successful unlock.  Displays the relock countdown time
        and the exact clock time at which the screen will lock again.
        Auto-closes after 5 seconds.  Click-through so it never obstructs work.
    -->

    <Border
        Background="#DD0D2018"
        CornerRadius="10"
        Padding="18,14"
        Margin="16"
        MinWidth="300">

        <Border.Effect>
            <DropShadowEffect
                Color="#000000"
                BlurRadius="22"
                ShadowDepth="0"
                Opacity="0.65"/>
        </Border.Effect>

        <StackPanel>

            <!-- Header row: icon + messages -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                <TextBlock
                    Text="&#x1F513;"
                    FontSize="18"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        x:Name="TitleText"
                        Text="Unlocked successfully"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#EAEAEA"/>

                    <TextBlock
                        x:Name="SubText"
                        Text=""
                        FontSize="12"
                        Foreground="#88CCAA"
                        Margin="0,3,0,0"
                        Visibility="Collapsed"/>

                </StackPanel>

            </StackPanel>

            <!-- 5-second countdown bar (shrinks left-to-right) -->
            <Grid Height="3">
                <Rectangle
                    Fill="#22FFFFFF"
                    RadiusX="2" RadiusY="2"/>
                <Rectangle
                    x:Name="TimerFill"
                    Fill="#44DD99"
                    RadiusX="2" RadiusY="2"
                    HorizontalAlignment="Left"
                    Width="268"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
