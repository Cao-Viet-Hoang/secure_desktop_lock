<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <appSettings>
        <!--
            Full path to your Firebase Realtime Database config JSON file.

            Required JSON format (firebase_config.json):
            {
              "base_path":   "https://<project-id>-default-rtdb.firebaseio.com/",
              "auth_secret": "<your-database-secret>"
            }

            Where to find the Database Secret:
              Firebase Console → Project Settings → Service Accounts → Database Secrets

            IMPORTANT: Never commit this file to source control.
            Add firebase_config.json to your .gitignore.

            Relative paths are resolved from the executable's directory.
            Example values:
              Relative : firebase_config.json
              Absolute : C:\ProgramData\SecureLock\firebase_config.json
        -->
        <add key="FirebaseConfigPath"
             value="firebase_config.json" />
    </appSettings>
</configuration>